# Copy to .env for local runs. In Railway, set these as service Variables.
# Secrets stay here / in Railway only — never commit real values.

# --- required ---
DATABASE_URL=postgresql://user:pass@host:5432/db   # Railway Postgres provides this automatically
GMAIL_USER=contact@plygrndstudio.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx              # Google App Password (needs 2-Step Verification)
APPSTORESPY_KEY=your_appstorespy_api_key
DASHBOARD_PASS=choose-a-strong-password

# --- safety (keep true until you have approved going live) ---
DRY_RUN=true

# --- brand / signature ---
COMPANY_NAME=PlayGround
OWNER_NAME=Yogev
OWNER_TITLE=Publishing Manager
OWNER_PHONE=+44 7828592964
WEBSITE=https://www.plygrndstudio.com
PUBLISH_URL=
CALENDAR_URL=

# --- reporting ---
SUMMARY_TO=contact@plygrndstudio.com

# --- sending schedule / ramp ---
TIMEZONE=Asia/Jerusalem
RAMP=30,50,75,100
RAMP_START_DATE=2026-07-27

# --- sourcing criteria (optional; defaults shown) ---
CATEGORIES=TOOLS,PRODUCTIVITY,PERSONALIZATION,PHOTOGRAPHY,VIDEO_PLAYERS,COMMUNICATION,ART_AND_DESIGN,MAPS_AND_NAVIGATION,WEATHER,HEALTH_AND_FITNESS
INSTALLS_MIN=15000
INSTALLS_MAX=300000
MIN_APPS=2
REVENUE_MAX=50000
REFILL_FLOOR=150
REFILL_TARGET=250

# --- dashboard ---
DASHBOARD_USER=admin
